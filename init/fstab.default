# Authored fstab for OnePlus 11 (salami) recovery.
#
# Base: LineageOS sm8550-common init/fstab.default (lineage-23.2),
# DELIBERATELY changed in three ways, each documented below:
#
# 1. AVB flags REMOVED from every logical row. The stock recovery
#    fstab (unpacked from the shipped stock recovery ramdisk) carries
#    NO avb flags on any logical partition, and recovery has no OOS
#    vbmeta keys to verify against. Verification stays where it
#    belongs: bootloader/first-stage via the stock vbmeta chain, plus
#    the manual --disable-verity/--disable-verification fastboot step
#    for modified slots (see BoardConfigCommon.mk). Recovery must
#    MOUNT OOS partitions, not re-verify them with keys it does not
#    have. Lineage's avb=vbmeta_system / avb=vbmeta_vendor flags are
#    therefore NOT carried over. If Phase 0 shows a mount failing
#    for want of an avb flag, that is a Phase 0 finding to fix here,
#    not something to guess now.
#
# 2. DUAL ext4+erofs rows for every logical partition, exactly as
#    the stock recovery fstab does. The stock fstab lists both
#    filesystem types per logical partition; fs_mgr tries them in
#    order. This makes mount behavior independent of any single
#    BOARD_*IMAGE_FILE_SYSTEM_TYPE value (see BoardConfigCommon.mk).
#
# 3. my_* rows ADDED from the stock recovery fstab (Lineage has
#    none: Lineage ROMs do not ship OnePlus my_* partitions).
#    nofail pattern copied EXACTLY from stock: nofail on my_company,
#    my_carrier, my_region, my_bigball, my_heytap, my_stock,
#    my_preload, my_manifest; NO nofail on my_product and
#    my_engineering (stock treats those two as required).
#    system_dlkm / vendor_dlkm rows are KEPT from Lineage even though
#    the stock recovery fstab omits them: recovery needs dlkm mounts
#    for module access, and Phase 0 verifies they mount.
#
# Physical rows (boot, init_boot, vendor_boot, dtbo, recovery) keep
# Lineage's slotselect,first_stage_mount form minus the avb flag
# (same reasoning as (1)); stock recovery fstab uses bare "defaults"
# for /boot and /recovery, but recovery must address the ACTIVE
# slot's partitions, so slotselect stays.
#
# /data row is the STOCK recovery fstab row verbatim (including
# "resize"), with FBE + metadata encryption parameters that match
# the Lineage row exactly (aes-256-xts:aes-256-cts:v2+
# inlinecrypt_optimized+wrappedkey_v0, keydirectory
# /metadata/vold/metadata_encryption, metadata_encryption
# aes-256-xts:wrappedkey_v0).
#
# The filesystem that contains the filesystem checker binary
# (typically /system) cannot specify MF_CHECK, and must come before
# any filesystems that do specify MF_CHECK.

#<src>                                                 <mnt_point>            <type>  <mnt_flags and options>                            <fs_mgr_flags>
system                                                  /system                ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
system                                                  /system                erofs   ro                                                   wait,slotselect,logical,first_stage_mount
system_ext                                              /system_ext            ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
system_ext                                              /system_ext            erofs   ro                                                   wait,slotselect,logical,first_stage_mount
product                                                 /product               ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
product                                                 /product               erofs   ro                                                   wait,slotselect,logical,first_stage_mount
vendor                                                  /vendor                ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
vendor                                                  /vendor                erofs   ro                                                   wait,slotselect,logical,first_stage_mount
vendor_dlkm                                             /vendor_dlkm           ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
vendor_dlkm                                             /vendor_dlkm           erofs   ro                                                   wait,slotselect,logical,first_stage_mount
system_dlkm                                             /system_dlkm           ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
system_dlkm                                             /system_dlkm           erofs   ro                                                   wait,slotselect,logical,first_stage_mount
odm                                                     /odm                   ext4    ro,barrier=1,discard                                 wait,slotselect,logical,first_stage_mount
odm                                                     /odm                   erofs   ro                                                   wait,slotselect,logical,first_stage_mount
my_product                                              /my_product            ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount
my_product                                              /my_product            erofs   ro                                                   wait,slotselect,logical,first_stage_mount
my_company                                              /my_company            ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_company                                              /my_company            erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_carrier                                              /my_carrier            ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_carrier                                              /my_carrier            erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_region                                               /my_region             ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_region                                               /my_region             erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_bigball                                              /my_bigball            ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_bigball                                              /my_bigball            erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_heytap                                               /my_heytap             ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_heytap                                               /my_heytap             erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_stock                                                /my_stock              ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_stock                                                /my_stock              erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_preload                                              /my_preload            ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_preload                                              /my_preload            erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_manifest                                             /my_manifest           ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount,nofail
my_manifest                                             /my_manifest           erofs   ro                                                   wait,slotselect,logical,first_stage_mount,nofail
my_engineering                                          /my_engineering        ext4    ro,barrier=1                                         wait,slotselect,logical,first_stage_mount
my_engineering                                          /my_engineering        erofs   ro                                                   wait,slotselect,logical,first_stage_mount
/dev/block/by-name/boot                                 /boot                  emmc    defaults                                             slotselect,first_stage_mount
/dev/block/by-name/init_boot                            /init_boot             emmc    defaults                                             slotselect,first_stage_mount
/dev/block/by-name/vendor_boot                          /vendor_boot           emmc    defaults                                             slotselect,first_stage_mount
/dev/block/by-name/dtbo                                 /dtbo                  emmc    defaults                                             slotselect,first_stage_mount
/dev/block/by-name/recovery                             /recovery              emmc    defaults                                             slotselect,first_stage_mount
/dev/block/by-name/metadata                             /metadata              f2fs    noatime,nosuid,nodev,discard                         wait,formattable,first_stage_mount
/dev/block/by-name/oplusreserve2                        /cache                 ext4    nosuid,nodev,noatime,barrier=1                       wait,check,first_stage_mount
/dev/block/bootdevice/by-name/persist                   /mnt/vendor/persist    ext4    noatime,nosuid,nodev,barrier=1                       wait
/dev/block/bootdevice/by-name/userdata                  /data                  f2fs    noatime,nosuid,nodev,discard,inlinecrypt,reserve_root=32768,resgid=1065,fsync_mode=nobarrier    latemount,resize,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs
/dev/block/bootdevice/by-name/misc                      /misc                  emmc    defaults                                             defaults
/devices/platform/soc/8804000.sdhci/mmc_host*           /storage/sdcard1       vfat    nosuid,nodev                                         wait,voldmanaged=sdcard1:auto,encryptable=footer
/devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*   /storage/usbotg        vfat    nosuid,nodev                                         wait,voldmanaged=usbotg:auto
/dev/block/bootdevice/by-name/modem                     /vendor/firmware_mnt   vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
/dev/block/bootdevice/by-name/dsp                       /vendor/dsp            ext4    ro,nosuid,nodev,barrier=1                            wait,slotselect
/dev/block/bootdevice/by-name/vm-persist                /mnt/product/vm-persist     ext4    noatime,nosuid,nodev,barrier=1                  wait
/dev/block/bootdevice/by-name/bluetooth                 /vendor/bt_firmware    vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait,slotselect
/dev/block/bootdevice/by-name/qmcs                      /mnt/vendor/qmcs       vfat    noatime,nosuid,nodev,context=u:object_r:vendor_qmcs_file:s0   wait,check,formattable
